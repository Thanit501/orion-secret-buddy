PORT=3012
APP_URL=http://localhost:3012
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# The organizer also needs to verify their email with OTP.
ADMIN_EMAIL=organizer@example.com
DATABASE_PATH=./data/orion.sqlite
# smtp: actual delivery. outbox: local-only testing; writes OTP emails into data/outbox/.
MAIL_MODE=outbox
# Optional local-only login without email OTP. Never enable in production.
DEV_SKIP_OTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ORION <orion@example.com>
